PORT=3000
NODE_ENV=development

# Opcional: si está definida, tiene prioridad sobre DB_*
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gran_parrillada_timbo
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres
# true para proxy público de Railway (*.proxy.rlwy.net)
DB_SSL=false

# true solo en desarrollo para crear/alterar tablas automáticamente
DB_SYNC=false
DB_LOGGING=false

JWT_SECRET=cambia_este_secreto_jwt
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173

# Correo para confirmar que el email del usuario existe.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 y una contraseña de aplicación.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
